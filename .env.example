# J.A.R.V.I.S. Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to git.
#
# ═══════════════════════════════════════════════════════
# ALL APIs below are 100% FREE — no credit card required
# ═══════════════════════════════════════════════════════

# ─── Cloud LLM Providers (all free) ────────────────────────────

# Google Gemini API key (primary cloud LLM — free tier)
# Get one at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Groq API key (ultra-fast 70B model inference — free tier)
# Get one at: https://console.groq.com — no credit card required
# Free tier: ~30 RPM / 14,400 RPD
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API key (20+ free community LLM models)
# Get one at: https://openrouter.ai/keys — no credit card required
# Free models are suffixed with :free
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── Anthropic Claude — best-in-class for building/coding by voice ──
# Get one at: https://console.anthropic.com/settings/keys (paid — usage-based)
# When set, multi-step "build me X" voice commands route to Claude.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional overrides:
# ANTHROPIC_MODEL=claude-opus-4-8           # most capable (default)
# PREFER_CLAUDE=false                       # true = use Claude for ALL requests
# Which model drives multi-step "build me X" commands:
#   auto (default) = Claude if it has credits, else Groq, else free tier
#   claude | groq | free
# JARVIS_AGENTIC_PROVIDER=auto
# Tip: add a free GROQ_API_KEY above so builds keep working when Claude has no credits.

# Optional: Force cloud-only mode (never use local Ollama)
# PREFER_CLOUD_ONLY=false

# ─── Integrations (all free) ──────────────────────────────────

# Telegram Bot Token (for Telegram bridge — free)
# Get one from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Email — read/send/search + proactive new-mail voice/Telegram notifications
# Gmail: turn on 2-Step Verification, then create an App Password at
#   https://myaccount.google.com/apppasswords  (use that, NOT your normal password)
# Outlook/Yahoo: use an app password the same way if 2FA is on.
JARVIS_EMAIL_ADDRESS=your_email@gmail.com
JARVIS_EMAIL_PASSWORD=your_app_password_here
# Optional overrides (auto-detected from the address for gmail/outlook/yahoo):
# JARVIS_EMAIL_IMAP=imap.gmail.com
# JARVIS_EMAIL_SMTP=smtp.gmail.com
# How often the background watcher checks for new mail, in seconds:
# JARVIS_EMAIL_POLL_INTERVAL=60

# Samsung SmartThings Personal Access Token (for AC & Smart Home — free)
# Get one at: https://account.smartthings.com/tokens
SMARTTHINGS_PAT=your_smartthings_token_here

# n8n Workflow Automation (self-hosted = free)
# Install: npm install n8n -g (https://n8n.io)
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key_here
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# ─── Local Settings ──────────────────────────────────────────

JARVIS_DATA_DIR=~/.jarvis
JARVIS_LOG_LEVEL=INFO
